# Output file paths — update as results are generated.
# Format: OUT_{TASK}_{INDEX}_{TYPE}=filename
# Index matches the source image in test_images/.

# Upload panel
OUT_UPLOAD_001_OVERLAY=upload_001_overlay.png
OUT_UPLOAD_001_JSON=upload_001_json.json

# Cell detection — POST /api/detect-cells  (Priority 1)
OUT_DETECT_001_OVERLAY=detect_001_overlay.png
OUT_DETECT_001_MASK=detect_001_mask.png
OUT_DETECT_001_JSON=detect_001_json.json
OUT_DETECT_002_OVERLAY=detect_002_overlay.png
OUT_DETECT_002_MASK=detect_002_mask.png
OUT_DETECT_002_JSON=detect_002_json.json

# Tissue segmentation — POST /api/segment  (Priority 2)
OUT_SEGMENT_001_MASK=segment_001_mask.png
OUT_SEGMENT_001_JSON=segment_001_json.json
OUT_SEGMENT_002_MASK=segment_002_mask.png
OUT_SEGMENT_002_JSON=segment_002_json.json

# Cell morphology metrics — POST /api/morphology  (Priority 3)
OUT_MORPHOLOGY_001_OVERLAY=morphology_001_overlay.png
OUT_MORPHOLOGY_001_CHART=morphology_001_chart.png
OUT_MORPHOLOGY_001_CSV=morphology_001_csv.csv
OUT_MORPHOLOGY_001_JSON=morphology_001_json.json
OUT_MORPHOLOGY_002_OVERLAY=morphology_002_overlay.png
OUT_MORPHOLOGY_002_CSV=morphology_002_csv.csv
OUT_MORPHOLOGY_002_JSON=morphology_002_json.json

# Stomata analysis — POST /api/stomata  (Priority 4)
OUT_STOMATA_001_OVERLAY=stomata_001_overlay.png
OUT_STOMATA_001_CHART=stomata_001_chart.png
OUT_STOMATA_001_JSON=stomata_001_json.json
OUT_STOMATA_002_OVERLAY=stomata_002_overlay.png
OUT_STOMATA_002_CHART=stomata_002_chart.png
OUT_STOMATA_002_JSON=stomata_002_json.json

# Vascular tissue analysis — POST /api/vascular  (Priority 5)
OUT_VASCULAR_001_OVERLAY=vascular_001_overlay.png
OUT_VASCULAR_001_MASK=vascular_001_mask.png
OUT_VASCULAR_001_CHART=vascular_001_chart.png
OUT_VASCULAR_001_JSON=vascular_001_json.json
OUT_VASCULAR_002_OVERLAY=vascular_002_overlay.png
OUT_VASCULAR_002_MASK=vascular_002_mask.png
OUT_VASCULAR_002_JSON=vascular_002_json.json

# Report
OUT_REPORT_001_PDF=report_001_report.pdf

# Root directory (relative to project root)
OUTPUT_DIR=output
