# Test image paths — update these when adding new samples.
# Format: TEST_IMG_{TASK}_{INDEX}=filename
# Tasks map to backend API endpoints (see note_plan.md for full spec).

# Upload panel — smoke tests, any section image
TEST_IMG_UPLOAD_001=upload_001.jpg
TEST_IMG_UPLOAD_002=upload_002.png

# Cell detection — POST /api/detect-cells  (Priority 1)
TEST_IMG_DETECT_001=detect_001.jpg
TEST_IMG_DETECT_002=detect_002.jpg

# Tissue segmentation — POST /api/segment  (Priority 2)
TEST_IMG_SEGMENT_001=segment_001.jpg
TEST_IMG_SEGMENT_002=segment_002.jpg

# Cell morphology metrics — POST /api/morphology  (Priority 3)
TEST_IMG_MORPHOLOGY_001=morphology_001.jpg
TEST_IMG_MORPHOLOGY_002=morphology_002.jpg

# Stomata analysis — POST /api/stomata  (Priority 4)
TEST_IMG_STOMATA_001=stomata_001.jpg
TEST_IMG_STOMATA_002=stomata_002.jpg

# Vascular tissue analysis — POST /api/vascular  (Priority 5)
TEST_IMG_VASCULAR_001=vascular_001.jpg
TEST_IMG_VASCULAR_002=vascular_002.jpg

# Root directory (relative to project root)
TEST_IMAGES_DIR=test_images
